    "check": "astro check",
    "linkcheck": "node scripts/linkcheck.mjs",
    "deploy": "bash scripts/deploy-cloudflare.sh"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "astro": "^7.3.3",
    "marked": "^18.0.13",
    "pagefind": "^1.5.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "wrangler": "^4.137.0"
  }
}
