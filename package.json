{
  "name": "omarchylinux-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial Omarchy Linux field manual: hardware compatibility, error fixes, command and keybinding reference, version diffs.",
  "scripts": {
    "data": "bash scripts/build-data.sh",
