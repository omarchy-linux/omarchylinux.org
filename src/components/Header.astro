---
import { NAV, SITE } from '../lib/site';
const path = Astro.url.pathname;
---
<div class="strip" data-pagefind-ignore>
  <div class="wrap">
    <span>Unofficial community reference. Not affiliated with 37signals or the Omacom Foundation.</span>
    <span>Download Omarchy only from <a href={SITE.official.site} rel="noopener">omarchy.org</a>.</span>
  </div>
</div>
<header class="wrap hdr" data-pagefind-ignore>
  <a class="brand" href="/" aria-label="omarchylinux.org home">
    <span class="wm">omarchy<span>linux</span>.org</span>
    <span class="sub">Unofficial field manual</span>
  </a>
  <nav class="nav" aria-label="Primary">
    {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <div class="tools">
    <form class="search-form" action="/search/" method="get" role="search">
      <label class="skip" for="q">Search</label>
      <input id="q" name="q" type="search" placeholder="Search errors, models, commands" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">Theme</button>
  </div>
</header>
